function solve(input) {
  let n = Number(input[0]);

  for (let num = 1; num <= n; num++) {
    let sum = 0;
    let temp = num;

    while (temp > 0) {
      sum += temp % 10;
      temp = parseInt(temp / 10);
    }

    let isSpecial = sum === 5 || sum === 7 || sum === 11;

    console.log(`${num} -> ${isSpecial}`);
  }
}
